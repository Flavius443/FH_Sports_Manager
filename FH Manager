    <script>
        // GLOBAL STATE & DATA
        let isAdmin = false;
        let activeFavoriteTeamId = 't1';
        let activePitchTeam = 'A';

        // 12 UNIQUE AUSTRIAN UNIVERSITY & COLLEGE TEAMS
        const teamsData = [
            { id: 't1', name: 'FH Technikum Lions', city: 'Wien', color: '#3b82f6', rating: 84, studiengang: 'Technik & IT', form: 4.5, points: 27, played: 10, w: 9, d: 0, l: 1, gf: 32, ga: 10 },
            { id: 't2', name: 'HTL Mödling Wolves', city: 'Niederösterreich', color: '#10b981', rating: 82, studiengang: 'Ingenieurwesen', form: 4.0, points: 24, played: 10, w: 8, d: 0, l: 2, gf: 28, ga: 12 },
            { id: 't3', name: 'TU Graz Spartans', city: 'Steiermark', color: '#f59e0b', rating: 81, studiengang: 'Technische Wissenschaften', form: 4.0, points: 22, played: 10, w: 7, d: 1, l: 2, gf: 25, ga: 14 },
            { id: 't4', name: 'MCI Innsbruck Mountaineers', city: 'Tirol', color: '#ef4444', rating: 79, studiengang: 'Management & Law', form: 3.5, points: 19, played: 10, w: 6, d: 1, l: 3, gf: 21, ga: 15 },
            { id: 't5', name: 'FH Joanneum Panthers', city: 'Graz', color: '#8b5cf6', rating: 78, studiengang: 'Medizin & Wirtschaft', form: 3.5, points: 17, played: 10, w: 5, d: 2, l: 3, gf: 19, ga: 16 },
            { id: 't6', name: 'TGM Wien Wizards', city: 'Wien', color: '#ec4899', rating: 77, studiengang: 'Elektronik & IT', form: 3.5, points: 16, played: 10, w: 5, d: 1, l: 4, gf: 18, ga: 17 },
            { id: 't7', name: 'WU Executive Eagles', city: 'Wien', color: '#06b6d4', rating: 76, studiengang: 'Business Administration', form: 3.0, points: 14, played: 10, w: 4, d: 2, l: 4, gf: 16, ga: 18 },
            { id: 't8', name: 'FH Upper Austria Cyberhawks', city: 'Linz', color: '#f97316', rating: 75, studiengang: 'Informatik & Kommunikation', form: 3.0, points: 12, played: 10, w: 3, d: 3, l: 4, gf: 15, ga: 19 },
            { id: 't9', name: 'Uni Salzburg Bulls', city: 'Salzburg', color: '#84cc16', rating: 74, studiengang: 'Geistes- & Naturwissenschaften', form: 3.0, points: 10, played: 10, w: 3, d: 1, l: 6, gf: 13, ga: 22 },
            { id: 't10', name: 'IMC Krems Sharks', city: 'Niederösterreich', color: '#6366f1', rating: 73, studiengang: 'Life Sciences', form: 2.5, points: 8, played: 10, w: 2, d: 2, l: 6, gf: 11, ga: 24 },
            { id: 't11', name: 'FH Kärnten Dragons', city: 'Villach', color: '#14b8a6', rating: 72, studiengang: 'Systems Engineering', form: 2.5, points: 6, played: 10, w: 1, d: 3, l: 6, gf: 10, ga: 25 },
            { id: 't12', name: 'Vorarlberg Tech Falcons', city: 'Dornbirn', color: '#a855f7', rating: 70, studiengang: 'Mechatronik & Wirtschaft', form: 2.0, points: 4, played: 10, w: 1, d: 1, l: 8, gf: 8, ga: 28 }
        ];

        // SQUADS (11 starters + 5 subs = 16 players in 4-3-3 tactical formation)
        const positionNames = ['TW', 'LV', 'IV1', 'IV2', 'RV', 'ZDM', 'ZM', 'ZOM', 'LF', 'ST', 'RF', 'SUB1', 'SUB2', 'SUB3', 'SUB4', 'SUB5'];
        const positionRoles = ['Torwart', 'Linker Verteidiger', 'Innenverteidiger', 'Innenverteidiger', 'Rechter Verteidiger', 'Defensives Mittelfeld', 'Zentrales Mittelfeld', 'Offensives Mittelfeld', 'Linker Flügel', 'Mittelstürmer', 'Rechter Flügel', 'Ersatz-Torwart', 'Ersatz-Verteidiger', 'Ersatz-Mittelfeld', 'Ersatz-Stürmer', 'Ersatz-Joker'];

        let teamSquads = {};

        function initSquads() {
            teamsData.forEach(team => {
                let squad = [];
                for (let i = 0; i < 16; i++) {
                    let baseRating = Math.min(9.9, Math.max(5.5, (team.rating / 10) + (Math.random() * 1.2 - 0.6)));
                    let stars = Math.min(5, Math.max(2, Math.round((baseRating / 2) * 2) / 2));
                    
                    squad.push({
                        id: `${team.id}_p${i+1}`,
                        number: i + 1,
                        name: getSamplePlayerName(i, team.name),
                        pos: positionNames[i],
                        role: positionRoles[i],
                        studiengang: team.studiengang + ' B.Sc.',
                        age: 20 + Math.floor(Math.random() * 5),
                        stars: stars,
                        rating: parseFloat(baseRating.toFixed(1)),
                        goals: Math.floor(Math.random() * 5),
                        assists: Math.floor(Math.random() * 6)
                    });
                }
                teamSquads[team.id] = squad;
            });
        }

        function getSamplePlayerName(index, teamName) {
            const firstNames = ['Lukas', 'Julian', 'Maximilian', 'Leon', 'Paul', 'Felix', 'David', 'Tim', 'Jonas', 'Niklas', 'Sven', 'Marco', 'Tobias', 'Florian', 'Daniel', 'Simon'];
            const lastNames = ['Müller', 'Schmidt', 'Schneider', 'Fischer', 'Weber', 'Meyer', 'Wagner', 'Becker', 'Hoffmann', 'Schäfer', 'Koch', 'Bauer', 'Richter', 'Klein', 'Wolf', 'Schröder'];
            return firstNames[(index * 3) % firstNames.length] + ' ' + lastNames[(index * 2) % lastNames.length];
        }

        // ALGO MODIFIERS
        let algoParams = {
            homeAdv: 3.5,
            fatigue: 2.0,
            formVar: 4.0,
            tactical: 5.0,
            coach: 3.0,
            travel: 1.5
        };

        function updateAlgoParam(param, val) {
            algoParams[param] = parseFloat(val);
            document.getElementById(`val${param.charAt(0).toUpperCase() + param.slice(1)}`).innerText = val;
        }

        // TOURNAMENT STATE (Stage 0: start, Stage 1: QF & SF done, Stage 2: Live Final)
        let tournamentState = {
            stage: 0,
            qf: [
                { id: 'qf1', t1: 't1', t2: 't8', score1: 0, score2: 0, winner: null },
                { id: 'qf2', t1: 't4', t2: 't5', score1: 0, score2: 0, winner: null },
                { id: 'qf3', t1: 't2', t2: 't7', score1: 0, score2: 0, winner: null },
                { id: 'qf4', t1: 't3', t2: 't6', score1: 0, score2: 0, winner: null }
            ],
            sf: [
                { id: 'sf1', t1: null, t2: null, score1: 0, score2: 0, winner: null },
                { id: 'sf2', t1: null, t2: null, score1: 0, score2: 0, winner: null }
            ],
            final: { id: 'final', t1: null, t2: null, score1: 0, score2: 0, winner: null }
        };

        let liveMatchTimer = null;
        let matchSecond = 0;

        function calculateTeamPower(teamId, isHome = true) {
            const team = teamsData.find(t => t.id === teamId);
            if (!team) return 50;
            let homeBonus = isHome ? algoParams.homeAdv : 0;
            let formBonus = team.form * (algoParams.formVar / 2);
            let tacticalBonus = algoParams.tactical - algoParams.fatigue;
            return team.rating + homeBonus + formBonus + tacticalBonus;
        }

        function simulateMatchScore(t1Id, t2Id) {
            let p1 = calculateTeamPower(t1Id, true);
            let p2 = calculateTeamPower(t2Id, false);
            let diff = (p1 - p2) / 10;
            let g1 = Math.max(0, Math.round(1.5 + diff + (Math.random() * 2 - 1)));
            let g2 = Math.max(0, Math.round(1.2 - diff + (Math.random() * 2 - 1)));
            if (g1 === g2) {
                if (Math.random() > 0.5) g1 += 1; else g2 += 1;
            }
            return { score1: g1, score2: g2, winner: g1 > g2 ? t1Id : t2Id };
        }

        // STAGE 1: SIMULATE UP TO SEMIFINALS
        function simulateStage1() {
            if (tournamentState.stage >= 1) return;

            tournamentState.qf.forEach(m => {
                let res = simulateMatchScore(m.t1, m.t2);
                m.score1 = res.score1;
                m.score2 = res.score2;
                m.winner = res.winner;
            });

            tournamentState.sf[0].t1 = tournamentState.qf[0].winner;
            tournamentState.sf[0].t2 = tournamentState.qf[1].winner;
            tournamentState.sf[1].t1 = tournamentState.qf[2].winner;
            tournamentState.sf[1].t2 = tournamentState.qf[3].winner;

            tournamentState.sf.forEach(m => {
                let res = simulateMatchScore(m.t1, m.t2);
                m.score1 = res.score1;
                m.score2 = res.score2;
                m.winner = res.winner;
            });

            tournamentState.final.t1 = tournamentState.sf[0].winner;
            tournamentState.final.t2 = tournamentState.sf[1].winner;
            tournamentState.stage = 1;

            updateBracketUI();

            const btnFinal = document.getElementById('btnStartLiveFinal');
            btnFinal.disabled = false;
            btnFinal.classList.remove('opacity-50', 'cursor-not-allowed', 'bg-gray-700');
            btnFinal.classList.add('bg-accent-green', 'hover:bg-green-600', 'animate-pulse');

            setupLiveFinalDashboard();
        }

        function setupLiveFinalDashboard() {
            const teamA = teamsData.find(t => t.id === tournamentState.final.t1);
            const teamB = teamsData.find(t => t.id === tournamentState.final.t2);

            document.getElementById('liveFinalDashboard').classList.remove('hidden');
            document.getElementById('finalTeamAName').innerText = teamA.name;
            document.getElementById('finalTeamBName').innerText = teamB.name;
            document.getElementById('finalTeamAIcon').innerText = teamA.name.substring(0, 2).toUpperCase();
            document.getElementById('finalTeamBIcon').innerText = teamB.name.substring(0, 2).toUpperCase();
            document.getElementById('finalTeamAForm').innerText = `Form: ${'★'.repeat(Math.floor(teamA.form))}`;
            document.getElementById('finalTeamBForm').innerText = `Form: ${'★'.repeat(Math.floor(teamB.form))}`;

            document.getElementById('finalScore').innerText = '0 - 0';
            document.getElementById('matchTimer').innerText = "00' (0s)";

            renderTacticalPitch();
        }

        // STAGE 2: 90-SECOND LIVE FINAL
        function startLiveFinal() {
            if (tournamentState.stage === 2) return;
            tournamentState.stage = 2;

            const btnFinal = document.getElementById('btnStartLiveFinal');
            btnFinal.disabled = true;
            btnFinal.classList.remove('animate-pulse', 'bg-accent-green');
            btnFinal.classList.add('bg-gray-700', 'opacity-50');

            matchSecond = 0;
            tournamentState.final.score1 = 0;
            tournamentState.final.score2 = 0;

            const teamA = teamsData.find(t => t.id === tournamentState.final.t1);
            const teamB = teamsData.find(t => t.id === tournamentState.final.t2);

            addTickerEvent(0, 'whistle', `Anpfiff! Das große Finale zwischen ${teamA.name} und ${teamB.name} läuft!`);

            liveMatchTimer = setInterval(() => {
                matchSecond++;
                let minStr = matchSecond < 10 ? `0${matchSecond}` : `${matchSecond}`;
                document.getElementById('matchTimer').innerText = `${minStr}' (${matchSecond}s)`;

                evaluateLiveEvents(matchSecond, teamA, teamB);

                if (matchSecond >= 90) {
                    clearInterval(liveMatchTimer);
                    finishLiveFinal(teamA, teamB);
                }
            }, 1000);
        }

        function evaluateLiveEvents(min, teamA, teamB) {
            let rand = Math.random();
            if (rand < 0.06) {
                let isTeamA = Math.random() < (teamA.rating / (teamA.rating + teamB.rating));
                let scoringTeam = isTeamA ? teamA : teamB;
                let opponentTeam = isTeamA ? teamB : teamA;

                if (isTeamA) tournamentState.final.score1++;
                else tournamentState.final.score2++;

                document.getElementById('finalScore').innerText = `${tournamentState.final.score1} - ${tournamentState.final.score2}`;

                let squad = teamSquads[scoringTeam.id];
                let scorer = squad[Math.floor(Math.random() * 4) + 7];
                let assist = squad[Math.floor(Math.random() * 4) + 4];

                scorer.rating = Math.min(10.0, parseFloat((scorer.rating + 1.0).toFixed(1)));
                scorer.goals++;
                assist.rating = Math.min(10.0, parseFloat((assist.rating + 0.5).toFixed(1)));
                assist.assists++;

                addTickerEvent(min, 'goal', `⚽ TOR für ${scoringTeam.name}! ${scorer.name} trifft zum ${tournamentState.final.score1}:${tournamentState.final.score2}! (Assist: ${assist.name})`);
                renderTacticalPitch();
            } else if (rand < 0.12) {
                let isTeamA = Math.random() > 0.5;
                let team = isTeamA ? teamA : teamB;
                let squad = teamSquads[team.id];
                let gk = squad[0];
                gk.rating = Math.min(10.0, parseFloat((gk.rating + 0.5).toFixed(1)));
                addTickerEvent(min, 'save', `🧤 Glanzparade von Torwart ${gk.name} (${team.name})!`);
                renderTacticalPitch();
            }
        }

        function finishLiveFinal(teamA, teamB) {
            let s1 = tournamentState.final.score1;
            let s2 = tournamentState.final.score2;
            if (s1 === s2) {
                if (Math.random() > 0.5) s1++; else s2++;
                tournamentState.final.score1 = s1;
                tournamentState.final.score2 = s2;
            }

            let winnerId = s1 > s2 ? teamA.id : teamB.id;
            let winnerTeam = teamsData.find(t => t.id === winnerId);
            tournamentState.final.winner = winnerId;

            document.getElementById('liveDot').classList.remove('bg-red-500', 'animate-pulse');
            document.getElementById('liveDot').classList.add('bg-gray-500');
            document.getElementById('liveStatusText').innerText = "BEENDET";

            addTickerEvent(90, 'trophy', `🏆 SCHLUSSPFIFF! ${winnerTeam.name} gewinnt das Finale und den Hochschul-Cup 2026!`);
            document.getElementById('winnerBanner').classList.remove('hidden');
            document.getElementById('winnerText').innerText = winnerTeam.name;

            updateBracketUI();
        }

        // FOTMOB 11v11 TACTICAL PITCH
        function switchPitchTeam(teamLetter) {
            activePitchTeam = teamLetter;
            document.getElementById('pitchBtnA').className = teamLetter === 'A' ? 'px-2.5 py-1 rounded bg-accent-blue text-white font-medium' : 'px-2.5 py-1 rounded bg-navy-700 text-gray-300 hover:bg-gray-700 font-medium';
            document.getElementById('pitchBtnB').className = teamLetter === 'B' ? 'px-2.5 py-1 rounded bg-accent-green text-white font-medium' : 'px-2.5 py-1 rounded bg-navy-700 text-gray-300 hover:bg-gray-700 font-medium';
            renderTacticalPitch();
        }

        function renderTacticalPitch() {
            const pitch = document.getElementById('pitchFormation');
            if (!pitch) return;

            const teamId = activePitchTeam === 'A' ? tournamentState.final.t1 : tournamentState.final.t2;
            if (!teamId) {
                pitch.innerHTML = `<div class="text-center text-gray-500 my-auto">Starte die Turniersimulation, um die Aufstellung zu sehen.</div>`;
                return;
            }

            const squad = teamSquads[teamId];
            if (!squad) return;

            // 4-3-3: Attackers (8,9,10), Midfielders (5,7,6), Defenders (1,2,3,4), GK (0)
            pitch.innerHTML = `
                <div class="flex justify-around items-center w-full">
                    ${renderPlayerBadge(squad[8])}
                    ${renderPlayerBadge(squad[9])}
                    ${renderPlayerBadge(squad[10])}
                </div>
                <div class="flex justify-around items-center w-full px-6">
                    ${renderPlayerBadge(squad[5])}
                    ${renderPlayerBadge(squad[7])}
                    ${renderPlayerBadge(squad[6])}
                </div>
                <div class="flex justify-around items-center w-full">
                    ${renderPlayerBadge(squad[1])}
                    ${renderPlayerBadge(squad[2])}
                    ${renderPlayerBadge(squad[3])}
                    ${renderPlayerBadge(squad[4])}
                </div>
                <div class="flex justify-center items-center w-full">
                    ${renderPlayerBadge(squad[0])}
                </div>
            `;
        }

        function renderPlayerBadge(player) {
            let ratingBg = player.rating >= 7.5 ? 'bg-green-600' : (player.rating >= 6.0 ? 'bg-yellow-600' : 'bg-red-600');
            return `
                <div onclick="openPlayerModal('${player.id}')" class="flex flex-col items-center group cursor-pointer transition transform hover:scale-110">
                    <div class="relative">
                        <div class="w-9 h-9 rounded-full bg-navy-800 border-2 border-gray-300 flex items-center justify-center font-bold text-xs text-white shadow-md">
                            ${player.number}
                        </div>
                        <span class="absolute -bottom-1 -right-2 ${ratingBg} text-white font-extrabold text-[10px] px-1.5 py-0.2 rounded-full shadow border border-navy-900">
                            ${player.rating.toFixed(1)}
                        </span>
                    </div>
                    <span class="text-[11px] font-semibold text-white mt-1 drop-shadow bg-navy-900/80 px-1.5 py-0.5 rounded truncate max-w-[80px]">
                        ${player.name.split(' ')[1] || player.name}
                    </span>
                </div>
            `;
        }

        function addTickerEvent(min, type, message) {
            const container = document.getElementById('tickerContainer');
            if (!container) return;
            let icon = type === 'goal' ? 'fa-circle-dot text-accent-green' : (type === 'save' ? 'fa-hand text-accent-blue' : 'fa-futbol text-accent-blue');
            const item = document.createElement('div');
            item.className = 'bg-navy-800 border border-gray-800 p-2.5 rounded-xl flex items-start space-x-2.5';
            item.innerHTML = `
                <span class="font-mono font-bold text-accent-blue bg-navy-900 px-1.5 py-0.5 rounded text-[10px] shrink-0">${min}'</span>
                <i class="fa-solid ${icon} mt-0.5 text-xs"></i>
                <p class="text-gray-200 text-xs leading-relaxed">${message}</p>
            `;
            container.prepend(item);
        }

        function updateBracketUI() {
            tournamentState.qf.forEach((qf, idx) => {
                const t1 = teamsData.find(t => t.id === qf.t1);
                const t2 = teamsData.find(t => t.id === qf.t2);
                document.getElementById(`qf${idx+1}-t1`).innerHTML = `<span>${t1.name}</span> <span class="font-bold border px-1.5 py-0.5 rounded ${qf.winner === qf.t1 ? 'bg-accent-green/20 text-accent-green border-accent-green' : 'bg-navy-800'}">${qf.score1}</span>`;
                document.getElementById(`qf${idx+1}-t2`).innerHTML = `<span>${t2.name}</span> <span class="font-bold border px-1.5 py-0.5 rounded ${qf.winner === qf.t2 ? 'bg-accent-green/20 text-accent-green border-accent-green' : 'bg-navy-800'}">${qf.score2}</span>`;
            });

            tournamentState.sf.forEach((sf, idx) => {
                if (sf.t1 && sf.t2) {
                    const t1 = teamsData.find(t => t.id === sf.t1);
                    const t2 = teamsData.find(t => t.id === sf.t2);
                    document.getElementById(`sf${idx+1}-t1`).innerHTML = `<span>${t1.name}</span> <span class="font-bold border px-1.5 py-0.5 rounded ${sf.winner === sf.t1 ? 'bg-accent-green/20 text-accent-green border-accent-green' : 'bg-navy-800'}">${sf.score1}</span>`;
                    document.getElementById(`sf${idx+1}-t2`).innerHTML = `<span>${t2.name}</span> <span class="font-bold border px-1.5 py-0.5 rounded ${sf.winner === sf.t2 ? 'bg-accent-green/20 text-accent-green border-accent-green' : 'bg-navy-800'}">${sf.score2}</span>`;
                }
            });

            if (tournamentState.final.t1 && tournamentState.final.t2) {
                const t1 = teamsData.find(t => t.id === tournamentState.final.t1);
                const t2 = teamsData.find(t => t.id === tournamentState.final.t2);
                document.getElementById('final-t1').innerHTML = `<span>${t1.name}</span> <span class="border px-2 py-0.5 rounded ${tournamentState.final.winner === t1.id ? 'bg-accent-gold/20 text-accent-gold border-accent-gold' : 'bg-navy-800'}">${tournamentState.final.score1}</span>`;
                document.getElementById('final-t2').innerHTML = `<span>${t2.name}</span> <span class="border px-2 py-0.5 rounded ${tournamentState.final.winner === t2.id ? 'bg-accent-gold/20 text-accent-gold border-accent-gold' : 'bg-navy-800'}">${tournamentState.final.score2}</span>`;
            }
        }

        function resetTournament() {
            if (liveMatchTimer) clearInterval(liveMatchTimer);
            tournamentState = {
                stage: 0,
                qf: [
                    { id: 'qf1', t1: 't1', t2: 't8', score1: 0, score2: 0, winner: null },
                    { id: 'qf2', t1: 't4', t2: 't5', score1: 0, score2: 0, winner: null },
                    { id: 'qf3', t1: 't2', t2: 't7', score1: 0, score2: 0, winner: null },
                    { id: 'qf4', t1: 't3', t2: 't6', score1: 0, score2: 0, winner: null }
                ],
                sf: [
                    { id: 'sf1', t1: null, t2: null, score1: 0, score2: 0, winner: null },
                    { id: 'sf2', t1: null, t2: null, score1: 0, score2: 0, winner: null }
                ],
                final: { id: 'final', t1: null, t2: null, score1: 0, score2: 0, winner: null }
            };
            initSquads();
            document.getElementById('liveFinalDashboard').classList.add('hidden');
            document.getElementById('btnStartLiveFinal').disabled = true;
            document.getElementById('btnStartLiveFinal').className = "flex-1 lg:flex-none px-5 py-2.5 bg-gray-700 opacity-50 cursor-not-allowed text-white font-semibold rounded-xl transition shadow-md flex items-center justify-center gap-2";
            document.getElementById('tickerContainer').innerHTML = '<div class="text-gray-500 italic text-center py-8">Das Spiel steht bereit. Klicken Sie auf "Stufe 2: Finale Live", um zu starten.</div>';
            document.getElementById('winnerBanner').classList.add('hidden');
            updateBracketUI();
        }

        // SQUAD VIEW
        function renderSquadTable(teamId) {
            const squad = teamSquads[teamId] || [];
            const tbody = document.getElementById('squadTableBody');
            tbody.innerHTML = '';

            squad.forEach(p => {
                let starHtml = '';
                let fullStars = Math.floor(p.stars);
                let halfStar = (p.stars % 1) !== 0;
                for (let i = 0; i < fullStars; i++) starHtml += '<i class="fa-solid fa-star text-accent-gold text-xs"></i>';
                if (halfStar) starHtml += '<i class="fa-solid fa-star-half-stroke text-accent-gold text-xs"></i>';
                for (let i = (fullStars + (halfStar ? 1 : 0)); i < 5; i++) starHtml += '<i class="fa-regular fa-star text-gray-600 text-xs"></i>';

                let tr = document.createElement('tr');
                tr.className = 'hover:bg-navy-900/50 transition cursor-pointer';
                tr.onclick = () => openPlayerModal(p.id);
                tr.innerHTML = `
                    <td class="p-3 font-bold text-accent-blue">${p.pos}</td>
                    <td class="p-3 font-semibold text-white">${p.name}</td>
                    <td class="p-3 text-xs text-gray-400">${p.studiengang}</td>
                    <td class="p-3 text-xs text-gray-400">${p.age} J.</td>
                    <td class="p-3">${starHtml} <span class="text-xs text-gray-400 ml-1">(${p.stars})</span></td>
                    <td class="p-3 text-xs text-accent-green">Topfit</td>
                    <td class="p-3 text-right">
                        ${isAdmin ? `<button onclick="event.stopPropagation(); editPlayerRating('${teamId}', '${p.id}')" class="text-xs bg-navy-700 hover:bg-gray-700 text-white px-2 py-1 rounded">Edit</button>` : '<span class="text-xs text-gray-600">Details</span>'}
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function editPlayerRating(teamId, playerId) {
            let player = teamSquads[teamId].find(p => p.id === playerId);
            if (!player) return;
            let newRat = prompt(`Neues Rating für ${player.name} (4.0 - 10.0):`, player.rating);
            if (newRat !== null) {
                player.rating = Math.min(10.0, Math.max(4.0, parseFloat(newRat) || player.rating));
                renderSquadTable(teamId);
            }
        }

        // PLAYER MODAL
        function openPlayerModal(playerId) {
            let foundPlayer = null;
            let foundTeamName = '';
            for (let tId in teamSquads) {
                let p = teamSquads[tId].find(x => x.id === playerId);
                if (p) {
                    foundPlayer = p;
                    foundTeamName = teamsData.find(t => t.id === tId).name;
                    break;
                }
            }
            if (!foundPlayer) return;

            document.getElementById('modalPlayerPos').innerText = foundPlayer.pos;
            document.getElementById('modalPlayerName').innerText = foundPlayer.name;
            document.getElementById('modalPlayerTeam').innerText = foundTeamName;
            document.getElementById('modalPlayerStudy').innerText = foundPlayer.studiengang;
            document.getElementById('modalPlayerStars').innerText = `${'★'.repeat(Math.floor(foundPlayer.stars))} (${foundPlayer.stars})`;
            document.getElementById('modalPlayerGoals').innerText = `${foundPlayer.goals} Tore / ${foundPlayer.assists} Vorlagen`;

            document.getElementById('playerModal').classList.remove('hidden');
        }

        function closePlayerModal() {
            document.getElementById('playerModal').classList.add('hidden');
        }

        // ALGORITHM TEST MATCH
        function runAlgorithmTestMatch() {
            let t1 = teamsData[Math.floor(Math.random() * teamsData.length)];
            let t2 = teamsData[Math.floor(Math.random() * teamsData.length)];
            while (t1.id === t2.id) t2 = teamsData[Math.floor(Math.random() * teamsData.length)];

            let res = simulateMatchScore(t1.id, t2.id);
            alert(`Testspiel-Ergebnis (Algorithmus 1A & 1B aktiv):\n${t1.name} ${res.score1} : ${res.score2} ${t2.name}\nSieger: ${res.score1 > res.score2 ? t1.name : t2.name}`);
        }

        // LEAGUE TABLE
        function renderLeagueTable() {
            const tbody = document.getElementById('leagueTableBody');
            tbody.innerHTML = '';
            let sorted = [...teamsData].sort((a, b) => b.points - a.points || (b.gf - b.ga) - (a.gf - a.ga));

            sorted.forEach((t, idx) => {
                let tr = document.createElement('tr');
                tr.className = t.id === activeFavoriteTeamId ? 'bg-accent-blue/10 font-semibold' : 'hover:bg-navy-900/50';
                tr.innerHTML = `
                    <td class="p-3 font-bold text-gray-400">${idx + 1}</td>
                    <td class="p-3 font-semibold text-white flex items-center gap-2">
                        ${t.id === activeFavoriteTeamId ? '<i class="fa-solid fa-heart text-red-500 text-xs"></i>' : ''}
                        ${t.name} <span class="text-xs text-gray-500 font-normal">(${t.city})</span>
                    </td>
                    <td class="p-3 text-center">${t.played}</td>
                    <td class="p-3 text-center text-gray-400">${t.w}</td>
                    <td class="p-3 text-center text-gray-400">${t.d}</td>
                    <td class="p-3 text-center text-gray-400">${t.l}</td>
                    <td class="p-3 text-center text-gray-400">${t.gf}:${t.ga}</td>
                    <td class="p-3 text-center ${t.gf - t.ga >= 0 ? 'text-accent-green' : 'text-red-400'}">${t.gf - t.ga}</td>
                    <td class="p-3 text-center font-black text-white">${t.points}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // DASHBOARD FAVORITE TEAM SHOWCASE
        function renderDashboardFavorite() {
            const fav = teamsData.find(t => t.id === activeFavoriteTeamId) || teamsData[0];
            const squad = teamSquads[fav.id] || [];
            const showcase = document.getElementById('favoriteTeamShowcase');

            showcase.innerHTML = `
                <div>
                    <h4 class="font-extrabold text-lg text-white">${fav.name}</h4>
                    <p class="text-xs text-gray-400">Standort: ${fav.city} • Fokus: ${fav.studiengang}</p>
                    <div class="mt-3 flex items-center space-x-3">
                        <span class="bg-navy-800 border border-gray-700 px-3 py-1 rounded-lg text-xs font-bold text-accent-blue">Rating: ${fav.rating}</span>
                        <span class="bg-navy-800 border border-gray-700 px-3 py-1 rounded-lg text-xs font-bold text-accent-gold">Form: ${'★'.repeat(Math.floor(fav.form))}</span>
                    </div>
                </div>
                <div class="md:col-span-2">
                    <h5 class="text-xs font-bold text-gray-400 mb-2">Top-Spieler im Kader:</h5>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
                        ${squad.slice(0, 3).map(p => `
                            <div class="bg-navy-800 p-2 rounded-xl border border-gray-800 text-xs">
                                <span class="font-bold text-white block truncate">${p.name}</span>
                                <span class="text-accent-blue text-[10px]">${p.pos} • ${p.stars} ⭐</span>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        // NAVIGATION & FAVORITE CHANGE
        function switchTab(tabId) {
            ['dashboard', 'tournament', 'squad', 'algorithms', 'table'].forEach(id => {
                const sec = document.getElementById(`sec-${id}`);
                const tab = document.getElementById(`tab-${id}`);
                if (sec) sec.classList.add('hidden');
                if (tab) tab.className = "w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition text-gray-400 hover:bg-navy-700 hover:text-white";
            });

            const activeSec = document.getElementById(`sec-${tabId}`);
            const activeTab = document.getElementById(`tab-${tabId}`);
            if (activeSec) activeSec.classList.remove('hidden');
            if (activeTab) activeTab.className = "w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition text-white bg-accent-blue/20 border border-accent-blue/40";
        }

        function populateTeamDropdowns() {
            const favSelect = document.getElementById('favTeamSelect');
            const squadSelect = document.getElementById('squadTeamSelect');
            if (!favSelect || !squadSelect) return;

            favSelect.innerHTML = '';
            squadSelect.innerHTML = '';

            teamsData.forEach(t => {
                let opt1 = new Option(t.name, t.id);
                let opt2 = new Option(t.name, t.id);
                favSelect.add(opt1);
                squadSelect.add(opt2);
            });

            favSelect.value = activeFavoriteTeamId;
            squadSelect.value = activeFavoriteTeamId;
        }

        function changeFavoriteTeam(teamId) {
            activeFavoriteTeamId = teamId;
            localStorage.setItem('fh_fav_team', teamId);
            renderLeagueTable();
            renderDashboardFavorite();
        }

        function toggleAdminMode() {
            isAdmin = !isAdmin;
            const btn = document.getElementById('adminBtn');
            const status = document.getElementById('adminStatus');

            if (isAdmin) {
                status.innerText = 'Admin: AN';
                btn.classList.add('bg-accent-blue', 'text-white', 'border-accent-blue');
            } else {
                status.innerText = 'Admin: AUS';
                btn.classList.remove('bg-accent-blue', 'text-white', 'border-accent-blue');
            }
            renderSquadTable(document.getElementById('squadTeamSelect').value);
        }

        // LOAD ON START
        window.onload = function() {
            const savedFav = localStorage.getItem('fh_fav_team');
            if (savedFav) activeFavoriteTeamId = savedFav;

            initSquads();
            populateTeamDropdowns();
            updateBracketUI();
            renderSquadTable(activeFavoriteTeamId);
            renderLeagueTable();
            renderDashboardFavorite();
        };
    </script>
</body>
</html>
