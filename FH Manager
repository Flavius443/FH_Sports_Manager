<!DOCTYPE html>
<html lang="de" class="dark h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FH-Sports Manager - Hochschul-Fußball</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        navy: {
                            900: '#0b0f19',
                            800: '#111827',
                            700: '#1f2937',
                            600: '#374151'
                        },
                        accent: {
                            green: '#10b981',
                            blue: '#3b82f6',
                            gold: '#f59e0b',
                            orange: '#f97316',
                            red: '#ef4444'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #0b0f19;
            color: #f3f4f6;
            font-family: 'Inter', sans-serif;
            user-select: none;
        }

        /* Pitch Gradient & Lines */
        .pitch-bg {
            background: linear-gradient(135deg, #0d3b1e 0%, #082412 100%);
            position: relative;
            border: 2px solid rgba(255, 255, 255, 0.2);
        }

        .pitch-line {
            position: absolute;
            border: 1px solid rgba(255, 255, 255, 0.25);
            pointer-events: none;
        }

        .rating-up {
            animation: pulse-green 1s ease-out;
        }

        .rating-down {
            animation: pulse-red 1s ease-out;
        }

        @keyframes pulse-green {
            0% { transform: scale(1.2); background-color: #059669; }
            100% { transform: scale(1); }
        }

        @keyframes pulse-red {
            0% { transform: scale(1.2); background-color: #dc2626; }
            100% { transform: scale(1); }
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #111827;
        }
        ::-webkit-scrollbar-thumb {
            background: #374151;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #4b5563;
        }
    </style>
</head>
<body class="bg-navy-900 text-gray-100 min-h-screen flex flex-col overflow-x-hidden">

    <!-- TOP HEADER -->
    <header class="bg-navy-800 border-b border-gray-800 sticky top-0 z-50 px-4 py-3 flex flex-wrap justify-between items-center shadow-lg">
        <div class="flex items-center space-x-3">
            <div class="bg-gradient-to-tr from-accent-blue to-accent-orange p-2.5 rounded-xl text-white shadow-md">
                <i class="fa-solid fa-futbol text-xl"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg leading-none bg-gradient-to-r from-white to-gray-400 bg-clip-text text-transparent">FH-Sports Manager</h1>
                <p class="text-xs text-gray-400 mt-0.5">Hochschulliga • <span id="currentSemesterLabel">WS 2024/25</span></p>
            </div>
        </div>

        <div class="flex items-center space-x-4 mt-2 sm:mt-0">
            <!-- Favorite Team Selector -->
            <div class="flex items-center space-x-2 bg-navy-900/80 px-3 py-1.5 rounded-lg border border-gray-700">
                <i class="fa-solid fa-heart text-red-500 text-sm"></i>
                <label for="favTeamSelect" class="text-xs text-gray-400">Lieblingsteam:</label>
                <select id="favTeamSelect" onchange="changeFavoriteTeam(this.value)" class="bg-transparent text-sm font-semibold text-white focus:outline-none cursor-pointer">
                    <!-- Dynamic teams -->
                </select>
            </div>

            <!-- Admin Mode Toggle -->
            <button onclick="toggleAdminMode()" id="adminBtn" class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border border-gray-700 bg-navy-700 hover:bg-gray-700 transition">
                <i class="fa-solid fa-user-gear"></i>
                <span id="adminStatus">Admin: AUS</span>
            </button>
        </div>
    </header>

    <!-- MAIN WRAPPER -->
    <div class="flex-1 flex flex-col md:flex-row">

        <!-- NAVIGATION SIDEBAR -->
        <aside class="w-full md:w-64 bg-navy-800 border-r border-gray-800 p-4 shrink-0">
            <nav class="space-y-1">
                <button onclick="switchTab('dashboard')" id="tab-dashboard" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition text-white bg-accent-blue/20 border border-accent-blue/40">
                    <i class="fa-solid fa-house text-accent-blue"></i>
                    <span>Dashboard</span>
                </button>
                <button onclick="switchTab('tournament')" id="tab-tournament" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition text-gray-400 hover:bg-navy-700 hover:text-white">
                    <i class="fa-solid fa-diagram-project text-gray-400"></i>
                    <span>Turnierbaum & Live</span>
                </button>
                <button onclick="switchTab('squad')" id="tab-squad" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition text-gray-400 hover:bg-navy-700 hover:text-white">
                    <i class="fa-solid fa-users text-gray-400"></i>
                    <span>Teams & Kader (4-3-3)</span>
                </button>
                <button onclick="switchTab('algorithms')" id="tab-algorithms" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition text-gray-400 hover:bg-navy-700 hover:text-white">
                    <i class="fa-solid fa-brain text-accent-orange"></i>
                    <span>Algorithmen (1A & 1B)</span>
                </button>
                <button onclick="switchTab('table')" id="tab-table" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium text-sm transition text-gray-400 hover:bg-navy-700 hover:text-white">
                    <i class="fa-solid fa-list-ol text-gray-400"></i>
                    <span>Ligatabelle & Stats</span>
                </button>
            </nav>

            <!-- Algorithm status box -->
            <div class="mt-8 p-3.5 bg-navy-900/60 rounded-xl border border-gray-800 text-xs text-gray-400 space-y-2">
                <div class="flex justify-between items-center text-gray-300 font-semibold border-b border-gray-800 pb-1.5">
                    <span><i class="fa-solid fa-microchip text-accent-blue mr-1"></i> AI Simulation</span>
                    <span class="text-accent-green">Active</span>
                </div>
                <p><strong>1A (Internal):</strong> Fatigue, Form, Home</p>
                <p><strong>1B (AI-Driven):</strong> Tactics, Coach, Travel</p>
            </div>
        </aside>

        <!-- MAIN CONTENT AREA -->
        <main class="flex-1 p-4 md:p-6 overflow-y-auto">

            <!-- TAB 0: DASHBOARD -->
            <section id="sec-dashboard" class="space-y-6">
                <div class="bg-gradient-to-r from-navy-800 to-navy-700 p-6 rounded-2xl border border-gray-700 shadow-xl flex flex-col md:flex-row justify-between items-center gap-6">
                    <div class="space-y-2">
                        <span class="bg-accent-blue/20 text-accent-blue border border-accent-blue/30 text-xs font-bold px-3 py-1 rounded-full">Schülerliga & Hochschul-Cup 2026/27</span>
                        <h2 class="text-2xl md:text-3xl font-extrabold text-white">Willkommen beim FH-Sports Manager</h2>
                        <p class="text-sm text-gray-300 max-w-xl">Verwalte dein Team, simuliere die österreichische Hochschulmeisterschaft mit 12 einzigartigen Teams, setze Algorithmen ein und verfolge das Live-Finale mit FotMob-Bewertungen!</p>
                    </div>
                    <div class="flex flex-col sm:flex-row gap-3">
                        <button onclick="switchTab('tournament')" class="px-5 py-3 bg-accent-blue hover:bg-blue-600 text-white font-bold rounded-xl shadow-lg transition flex items-center gap-2">
                            <i class="fa-solid fa-play"></i> Zum Turnierbaum
                        </button>
                        <button onclick="switchTab('squad')" class="px-5 py-3 bg-navy-600 hover:bg-gray-600 text-white font-semibold rounded-xl border border-gray-600 transition flex items-center gap-2">
                            <i class="fa-solid fa-users"></i> Kader ansehen
                        </button>
                    </div>
                </div>

                <!-- Quick Stats Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-navy-800 p-4 rounded-2xl border border-gray-800 flex items-center space-x-4">
                        <div class="p-3 bg-accent-blue/20 text-accent-blue rounded-xl"><i class="fa-solid fa-shield-halved text-xl"></i></div>
                        <div>
                            <div class="text-xs text-gray-400">Teilnehmende Teams</div>
                            <div class="text-xl font-extrabold text-white">12 Unis & HTLs</div>
                        </div>
                    </div>
                    <div class="bg-navy-800 p-4 rounded-2xl border border-gray-800 flex items-center space-x-4">
                        <div class="p-3 bg-accent-green/20 text-accent-green rounded-xl"><i class="fa-solid fa-user-group text-xl"></i></div>
                        <div>
                            <div class="text-xs text-gray-400">Spieler im Kader</div>
                            <div class="text-xl font-extrabold text-white">192 Aktive</div>
                        </div>
                    </div>
                    <div class="bg-navy-800 p-4 rounded-2xl border border-gray-800 flex items-center space-x-4">
                        <div class="p-3 bg-accent-gold/20 text-accent-gold rounded-xl"><i class="fa-solid fa-trophy text-xl"></i></div>
                        <div>
                            <div class="text-xs text-gray-400">Turnier-Modus</div>
                            <div class="text-xl font-extrabold text-white">K.-o. & Liga</div>
                        </div>
                    </div>
                    <div class="bg-navy-800 p-4 rounded-2xl border border-gray-800 flex items-center space-x-4">
                        <div class="p-3 bg-accent-orange/20 text-accent-orange rounded-xl"><i class="fa-solid fa-brain text-xl"></i></div>
                        <div>
                            <div class="text-xs text-gray-400">Engine-Version</div>
                            <div class="text-xl font-extrabold text-white">Algorithmus 1A/1B</div>
                        </div>
                    </div>
                </div>

                <!-- Favorite Team Showcase -->
                <div class="bg-navy-800 p-5 rounded-2xl border border-gray-800 shadow-lg space-y-4">
                    <h3 class="font-bold text-white text-base flex items-center gap-2">
                        <i class="fa-solid fa-heart text-red-500"></i> Aktuelles Lieblingsteam im Fokus
                    </h3>
                    <div id="favoriteTeamShowcase" class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center bg-navy-900 p-4 rounded-xl border border-gray-800">
                        <!-- Populated via JS -->
                    </div>
                </div>
            </section>

            <!-- TAB 1: TOURNAMENT & LIVE MATCH -->
            <section id="sec-tournament" class="hidden space-y-6">
                <!-- CONTROLS -->
                <div class="bg-navy-800 p-5 rounded-2xl border border-gray-800 shadow-lg flex flex-col lg:flex-row justify-between items-center gap-4">
                    <div>
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-sitemap text-accent-blue"></i> Hochschul-Cup 2026 Turniersimulation
                        </h2>
                        <p class="text-sm text-gray-400 mt-1">Stufe 1: Viertel- & Halbfinale simulieren. Stufe 2: 90-Sekunden Live-Finale verfolgen.</p>
                    </div>

                    <div class="flex flex-wrap gap-3 w-full lg:w-auto">
                        <button id="btnSimStage1" onclick="simulateStage1()" class="flex-1 lg:flex-none px-5 py-2.5 bg-accent-blue hover:bg-blue-600 text-white font-semibold rounded-xl transition shadow-md flex items-center justify-center gap-2">
                            <i class="fa-solid fa-forward-step"></i>
                            <span>Stufe 1: Bis Halbfinale simulieren</span>
                        </button>
                        
                        <button id="btnStartLiveFinal" onclick="startLiveFinal()" disabled class="flex-1 lg:flex-none px-5 py-2.5 bg-gray-700 opacity-50 cursor-not-allowed text-white font-semibold rounded-xl transition shadow-md flex items-center justify-center gap-2">
                            <i class="fa-solid fa-play"></i>
                            <span>Stufe 2: Finale Live (90 Sek.)</span>
                        </button>

                        <button onclick="resetTournament()" class="px-3 py-2.5 bg-navy-700 hover:bg-gray-700 text-gray-300 rounded-xl transition border border-gray-700" title="Turnier zurücksetzen">
                            <i class="fa-solid fa-rotate-right"></i>
                        </button>
                    </div>
                </div>

                <!-- LIVE FINALE DASHBOARD -->
                <div id="liveFinalDashboard" class="hidden bg-navy-800 rounded-2xl border border-gray-800 p-5 shadow-2xl space-y-6">
                    <div class="flex flex-col md:flex-row justify-between items-center gap-4 border-b border-gray-800 pb-5">
                        <div class="flex items-center space-x-4 w-full md:w-1/3 justify-start">
                            <div class="w-12 h-12 rounded-xl bg-accent-blue/20 border border-accent-blue flex items-center justify-center text-accent-blue font-bold text-lg" id="finalTeamAIcon">T1</div>
                            <div>
                                <h3 class="font-bold text-lg text-white" id="finalTeamAName">Team Alpha</h3>
                                <p class="text-xs text-gray-400" id="finalTeamAForm">Form: ★★★★☆</p>
                            </div>
                        </div>

                        <div class="flex flex-col items-center justify-center w-full md:w-1/3 my-2 md:my-0">
                            <div class="flex items-center space-x-2 bg-navy-900 px-4 py-1.5 rounded-full border border-gray-700 mb-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse" id="liveDot"></span>
                                <span class="text-xs font-mono font-bold text-red-400" id="liveStatusText">LIVE</span>
                                <span class="text-xs font-mono font-bold text-white border-l border-gray-700 pl-2" id="matchTimer">00' (0s)</span>
                            </div>
                            <div class="text-4xl font-black tracking-widest text-white" id="finalScore">0 - 0</div>
                            <div class="text-[11px] text-gray-400 mt-1">1 Sekunde = 1 Spielminute</div>
                        </div>

                        <div class="flex items-center space-x-4 w-full md:w-1/3 justify-end text-right">
                            <div>
                                <h3 class="font-bold text-lg text-white" id="finalTeamBName">Team Beta</h3>
                                <p class="text-xs text-gray-400" id="finalTeamBForm">Form: ★★★★☆</p>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-accent-green/20 border border-accent-green flex items-center justify-center text-accent-green font-bold text-lg" id="finalTeamBIcon">T2</div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                        <!-- FotMob 11v11 Pitch -->
                        <div class="lg:col-span-8 bg-navy-900 rounded-2xl p-4 border border-gray-800 flex flex-col">
                            <div class="flex justify-between items-center mb-3">
                                <span class="text-xs font-semibold text-gray-400 flex items-center gap-1.5">
                                    <i class="fa-solid fa-chalkboard-user text-accent-blue"></i> Live FotMob 4-3-3 Ratings
                                </span>
                                <div class="flex items-center space-x-2 text-[11px]">
                                    <button onclick="switchPitchTeam('A')" id="pitchBtnA" class="px-2.5 py-1 rounded bg-accent-blue text-white font-medium">Team A</button>
                                    <button onclick="switchPitchTeam('B')" id="pitchBtnB" class="px-2.5 py-1 rounded bg-navy-700 text-gray-300 hover:bg-gray-700 font-medium">Team B</button>
                                </div>
                            </div>

                            <div class="pitch-bg rounded-xl flex-1 min-h-[380px] p-4 relative overflow-hidden flex flex-col justify-between">
                                <div class="pitch-line inset-2 rounded-lg"></div>
                                <div class="pitch-line top-1/2 left-2 right-2 -translate-y-1/2 border-t"></div>
                                <div class="pitch-line top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-24 h-24 rounded-full border"></div>
                                <div class="pitch-line top-2 left-1/2 -translate-x-1/2 w-36 h-16 border-t-0"></div>
                                <div class="pitch-line bottom-2 left-1/2 -translate-x-1/2 w-36 h-16 border-b-0"></div>

                                <div id="pitchFormation" class="relative w-full h-full min-h-[350px] flex flex-col justify-between z-10 py-2"></div>
                            </div>
                        </div>

                        <!-- Ticker -->
                        <div class="lg:col-span-4 bg-navy-900 rounded-2xl p-4 border border-gray-800 flex flex-col h-[440px]">
                            <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3 flex items-center gap-2">
                                <i class="fa-solid fa-bolt text-accent-gold"></i> Live-Match Ticker & Algorithmus-Ereignisse
                            </h4>
                            <div id="tickerContainer" class="flex-1 overflow-y-auto space-y-2.5 pr-1 text-xs">
                                <div class="text-gray-500 italic text-center py-8">Das Spiel steht bereit. Klicken Sie auf "Stufe 2: Finale Live", um zu starten.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TOURNAMENT BRACKET GRAPHIC -->
                <div class="bg-navy-800 rounded-2xl border border-gray-800 p-6 shadow-lg overflow-x-auto">
                    <h3 class="text-sm font-bold text-gray-300 uppercase tracking-wider mb-6 flex items-center gap-2">
                        <i class="fa-solid fa-diagram-nested text-accent-blue"></i> Turnierbaum Hochschul-Cup (Start 0:0)
                    </h3>

                    <div class="min-w-[700px] grid grid-cols-3 gap-6 relative">
                        <!-- QUARTERFINALS -->
                        <div class="space-y-6">
                            <h4 class="text-xs font-semibold text-gray-400 text-center uppercase tracking-wider border-b border-gray-700 pb-2">Viertelfinale</h4>
                            <div class="bg-navy-900 border border-gray-700 rounded-xl p-3 space-y-2" id="qf1-card">
                                <div class="flex justify-between items-center text-xs font-semibold" id="qf1-t1"><span>Team 1</span> <span class="font-bold border px-1.5 py-0.5 rounded bg-navy-800">0</span></div>
                                <div class="flex justify-between items-center text-xs font-semibold" id="qf1-t2"><span>Team 2</span> <span class="font-bold border px-1.5 py-0.5 rounded bg-navy-800">0</span></div>
                            </div>
                            <div class="bg-navy-900 border border-gray-700 rounded-xl p-3 space-y-2" id="qf2-card">
                                <div class="flex justify-between items-center text-xs font-semibold" id="qf2-t1"><span>Team 3</span> <span class="font-bold border px-1.5 py-0.5 rounded bg-navy-800">0</span></div>
                                <div class="flex justify-between items-center text-xs font-semibold" id="qf2-t2"><span>Team 4</span> <span class="font-bold border px-1.5 py-0.5 rounded bg-navy-800">0</span></div>
                            </div>
                            <div class="bg-navy-900 border border-gray-700 rounded-xl p-3 space-y-2" id="qf3-card">
                                <div class="flex justify-between items-center text-xs font-semibold" id="qf3-t1"><span>Team 5</span> <span class="font-bold border px-1.5 py-0.5 rounded bg-navy-800">0</span></div>
                                <div class="flex justify-between items-center text-xs font-semibold" id="qf3-t2"><span>Team 6</span> <span class="font-bold border px-1.5 py-0.5 rounded bg-navy-800">0</span></div>
                            </div>
                            <div class="bg-navy-900 border border-gray-700 rounded-xl p-3 space-y-2" id="qf4-card">
                                <div class="flex justify-between items-center text-xs font-semibold" id="qf4-t1"><span>Team 7</span> <span class="font-bold border px-1.5 py-0.5 rounded bg-navy-800">0</span></div>
                                <div class="flex justify-between items-center text-xs font-semibold" id="qf4-t2"><span>Team 8</span> <span class="font-bold border px-1.5 py-0.5 rounded bg-navy-800">0</span></div>
                            </div>
                        </div>

                        <!-- SEMIFINALS -->
                        <div class="space-y-16 pt-8">
                            <h4 class="text-xs font-semibold text-gray-400 text-center uppercase tracking-wider border-b border-gray-700 pb-2">Halbfinale</h4>
                            <div class="bg-navy-900 border border-gray-700 rounded-xl p-3 space-y-2" id="sf1-card">
                                <div class="flex justify-between items-center text-xs font-semibold" id="sf1-t1"><span class="text-gray-500">Sieger QF 1</span> <span class="font-bold border px-1.5 py-0.5 rounded bg-navy-800">0</span></div>
                                <div class="flex justify-between items-center text-xs font-semibold" id="sf1-t2"><span class="text-gray-500">Sieger QF 2</span> <span class="font-bold border px-1.5 py-0.5 rounded bg-navy-800">0</span></div>
                            </div>
                            <div class="bg-navy-900 border border-gray-700 rounded-xl p-3 space-y-2" id="sf2-card">
                                <div class="flex justify-between items-center text-xs font-semibold" id="sf2-t1"><span class="text-gray-500">Sieger QF 3</span> <span class="font-bold border px-1.5 py-0.5 rounded bg-navy-800">0</span></div>
                                <div class="flex justify-between items-center text-xs font-semibold" id="sf2-t2"><span class="text-gray-500">Sieger QF 4</span> <span class="font-bold border px-1.5 py-0.5 rounded bg-navy-800">0</span></div>
                            </div>
                        </div>

                        <!-- FINAL -->
                        <div class="space-y-20 pt-20">
                            <h4 class="text-xs font-semibold text-accent-gold text-center uppercase tracking-wider border-b border-accent-gold/40 pb-2">
                                <i class="fa-solid fa-crown mr-1"></i> Finale
                            </h4>
                            <div class="bg-gradient-to-b from-navy-900 to-navy-800 border-2 border-accent-gold/50 rounded-xl p-4 space-y-3 shadow-xl" id="final-card">
                                <div class="flex justify-between items-center text-sm font-bold" id="final-t1">
                                    <span class="text-gray-500">Finalist 1</span> <span class="border px-2 py-0.5 rounded bg-navy-800">0</span>
                                </div>
                                <div class="flex justify-between items-center text-sm font-bold" id="final-t2">
                                    <span class="text-gray-500">Finalist 2</span> <span class="border px-2 py-0.5 rounded bg-navy-800">0</span>
                                </div>
                                <div id="winnerBanner" class="hidden text-center bg-accent-gold/20 text-accent-gold border border-accent-gold/40 rounded-lg py-1.5 font-extrabold text-xs">
                                    🏆 TURNIERSIEGER: <span id="winnerText">--</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- TAB 2: TEAMS & SQUADS (4-3-3) -->
            <section id="sec-squad" class="hidden space-y-6">
                <div class="bg-navy-800 p-5 rounded-2xl border border-gray-800 shadow-lg flex flex-col md:flex-row justify-between items-center gap-4">
                    <div>
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-users text-accent-blue"></i> 12 Österreichische Universitäten & Kader (4-3-3)
                        </h2>
